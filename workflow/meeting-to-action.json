      "name": "Transcript long enough?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5-5\",\n  max_tokens: 2000,\n  system: \"Always answer by calling the save_meeting_summary tool. You extract structured information from French business meeting transcripts. Write in French. Rules: (1) Only record what was actually said; never invent tasks, owners or dates. (2) If a decision was reversed during the meeting, record only the FINAL decision and ignore the cancelled one. (3) owner must be a person named in the transcript, otherwise null. (4) due_date must be YYYY-MM-DD, resolved from the meeting date (for example 'jeudi' or 'la semaine prochaine' relative to the meeting date); if the deadline is vague, approximate or only a period (for example 'la semaine prochaine', 'bientôt', 'dès que possible'), use null and keep the original wording in the task text. Only use a date when a specific day or date is stated or clearly implied (for example 'demain', 'jeudi', 'le 7 octobre', 'lundi'). (5) Actions cancelled during the meeting must not appear. (6) Items nobody took ownership of go in actions with owner null, and unresolved topics go in open_questions.\",\n  tools: [{\n    name: \"save_meeting_summary\",\n    description: \"Save the structured summary of the meeting\",\n    input_schema: {\n      type: \"object\",\n      properties: {\n        summary: { type: \"string\", description: \"3 to 5 sentence summary in French\" },\n        decisions: { type: \"array\", items: { type: \"string\" } },\n        actions: { type: \"array\", items: { type: \"object\", properties: {\n          task: { type: \"string\" },\n          owner: { type: [\"string\", \"null\"] },\n          due_date: { type: [\"string\", \"null\"], description: \"YYYY-MM-DD or null\" },\n          priority: { type: \"string\", enum: [\"high\", \"medium\", \"low\"] }\n        }, required: [\"task\", \"owner\", \"due_date\", \"priority\"] } },\n        open_questions: { type: \"array\", items: { type: \"string\" } }\n      },\n      required: [\"summary\", \"decisions\", \"actions\", \"open_questions\"]\n    }\n  }],\n  messages: [{ role: \"user\", content: \"Meeting: \" + $json.meeting_title + \"\\nDate: \" + $json.meeting_date + \" (\" + new Date($json.meeting_date).toLocaleDateString('fr-FR', { weekday: 'long' }) + \")\\nParticipants: \" + $json.participants + \"\\n\\nTranscript:\\n\" + $json.transcript }]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        -96
      ],
      "id": "84b5ac06-1ffe-42e1-8f86-012f6c17758e",
      "name": "Claude extract",
      "credentials": {
        "httpHeaderAuth": {
          "id": "haoAVcBj7mRq9BF3",
          "name": "Anthropic key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const blocks = $input.first().json.content || [];\nconst tool = blocks.find(b => b.type === 'tool_use');\n\nif (!tool || !tool.input) {\n  throw new Error('Claude did not return a tool_use block: ' + JSON.stringify(blocks).slice(0, 500));\n}\n\nconst result = tool.input;\nconst meta = $('Transcript long enough?').first().json;\n\nreturn [{\n  json: {\n    meeting_title: meta.meeting_title,\n    meeting_date: meta.meeting_date,\n    summary: result.summary,\n    decisions: result.decisions || [],\n    actions: result.actions || [],\n    open_questions: result.open_questions || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -96
      ],
      "id": "581fcef8-f544-4481-bc9b-9fcd2c81186a",
      "name": "Parse Claude output"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0C667708RJ",
          "mode": "id"
        },
        "text": "={{ \"*📋 \" + $json.meeting_title + \"* (\" + $json.meeting_date + \")\\n\\n*Résumé*\\n\" + $json.summary + \"\\n\\n*Décisions*\\n\" + $json.decisions.map(d => \"• \" + d).join(\"\\n\") + \"\\n\\n*Actions*\\n\" + $json.actions.map(a => \"• \" + a.task + \" — *\" + (a.owner || \"⚠️ sans responsable\") + \"* — \" + (a.due_date || \"pas d'échéance\") + \" (\" + a.priority + \")\").join(\"\\n\") + \"\\n\\n*Questions ouvertes*\\n\" + $json.open_questions.map(q => \"• \" + q).join(\"\\n\") }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
